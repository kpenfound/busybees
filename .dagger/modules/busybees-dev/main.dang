"""
Development support for busybees.

`testRuntime` is the container `dagger check` runs the Go tests, linters and
generators in (the `go` module's `base` setting in dagger.toml).
"""
type BusybeesDev {
  """
  The Go image the tests run in. The image sets the Go version; git comes
  with it.
  """
  pub testRuntime: Container! {
    container.from("golang:1.26-bookworm")
  }
}
